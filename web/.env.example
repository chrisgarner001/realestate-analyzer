# Copy this file to .env and fill in your values
ANTHROPIC_API_KEY=sk-ant-your-key-here
PORT=8000

# JWT secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-long-random-secret-string

# Super admin credentials (created automatically on first run)
SUPER_ADMIN_EMAIL=admin@yourapp.com
SUPER_ADMIN_PASSWORD=changeme123

# ── Production only (Cloud Run) ─────────────────────────────────────────────
# Leave blank for local dev (uses SQLite automatically)
# Cloud SQL (PostgreSQL) connection string — two formats:

# Option A — Unix socket (recommended for Cloud Run, set via gcloud deploy command)
# DATABASE_URL=postgresql+psycopg2://DB_USER:DB_PASS@/DB_NAME?host=/cloudsql/PROJECT:REGION:INSTANCE

# Option B — TCP (if using Cloud SQL public IP or local proxy)
# DATABASE_URL=postgresql+psycopg2://DB_USER:DB_PASS@127.0.0.1:5432/DB_NAME

# Option C — Supabase Postgres (project URL: https://qkofsiovtioqzvgrwnls.supabase.co)
# Use your actual database password from the Supabase dashboard.
# DATABASE_URL=postgresql://postgres:YOUR_SUPABASE_DB_PASSWORD@db.qkofsiovtioqzvgrwnls.supabase.co:5432/postgres?sslmode=require

# Report delivery (SMTP). Without SMTP_HOST, reports remain in the database
# but are not emailed.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=reports@example.com
# SMTP_PASSWORD=replace-me
# SMTP_FROM=reports@example.com
# REPORT_NOTIFICATION_EMAIL=partner@example.com
